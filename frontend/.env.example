# ─── Frontend Environment Variables ─────────────────────────────────────────
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# API base URL.
# In development the Vite proxy handles /api → http://localhost:3000,
# so this can remain empty (defaults to '/api' in axiosInstance.js).
# In production set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=
